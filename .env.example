# Copy to .env and fill in. Never commit .env.
# Use the READ-ONLY role created by scripts/db/reader-role.sql, never an owner account.
DATABASE_URL=postgres://nl_sql_reader:<reader-password>@localhost:5432/postgres
# Owner connection used only by `npm run db:setup`. Never used by the API.
ADMIN_DATABASE_URL=postgres://<owner>@localhost:5432/postgres
READER_PASSWORD=<choose-a-long-random-password>
PORT=3000
# "rules" needs no model. "ollama" calls a local Ollama server to write the SQL.
LLM_PROVIDER=rules
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
ALLOWED_TABLES=customers,products,orders,order_items
ROW_LIMIT=100
STATEMENT_TIMEOUT_MS=3000
RATE_LIMIT_PER_MINUTE=60
